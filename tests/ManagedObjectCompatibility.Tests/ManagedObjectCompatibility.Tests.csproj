<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>13</LangVersion>
    <RainWorldDir Condition="'$(RainWorldDir)' == ''">D:/Steam/steamapps/common/Rain World</RainWorldDir>
    <PomDllPath Condition="'$(PomDllPath)' == ''">$(RainWorldDir)/../../workshop/content/312520/2920439169/plugins/Pom.dll</PomDllPath>
    <RainWrightDllPath Condition="'$(RainWrightDllPath)' == ''">$(BaseOutputPath)../Rainwright/Release/RainWright.dll</RainWrightDllPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="RainWright"><HintPath>$(RainWrightDllPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(RainWorldDir)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Pom"><HintPath>$(PomDllPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="PUBLIC-Assembly-CSharp"><HintPath>$(RainWorldDir)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HOOKS-Assembly-CSharp"><HintPath>$(RainWorldDir)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
