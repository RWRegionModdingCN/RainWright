<Project>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);RAINWRIGHT_RUNTIME</DefineConstants>
    <RainWorldDir Condition="'$(RainWorldDir)' == '' and '$(RainWorldPath)' != ''">$(RainWorldPath)</RainWorldDir>
    <RainWorldDir Condition="'$(RainWorldDir)' == '' and Exists('D:/Steam/steamapps/common/Rain World')">D:/Steam/steamapps/common/Rain World</RainWorldDir>
    <RainWrightModRootDir Condition="'$(RainWrightModRootDir)' == '' and '$(RainWorldDir)' != ''">$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/RainWright</RainWrightModRootDir>
    <RainWrightModOutputDir Condition="'$(RainWrightModOutputDir)' == '' and '$(RainWrightModRootDir)' != ''">$(RainWrightModRootDir)/newest/plugins</RainWrightModOutputDir>
    <OutputPath Condition="'$(DeployToGame)' == 'true'">$(RainWrightModOutputDir)</OutputPath>
    <RWImGuiWorkshopRootPluginDir>$(RainWorldDir)/../../workshop/content/312520/3417372413/plugins</RWImGuiWorkshopRootPluginDir>
    <RWImGuiWorkshopPackagePluginDir>$(RainWorldDir)/../../workshop/content/312520/3417372413/rwimgui/plugins</RWImGuiWorkshopPackagePluginDir>
    <RWImGuiLocalPluginDir>$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/rwimgui/plugins</RWImGuiLocalPluginDir>
    <RWImGuiPluginDir Condition="'$(RWImGuiPluginDir)' == '' and Exists('$(RWImGuiWorkshopRootPluginDir)/rain-world-imgui-api.dll')">$(RWImGuiWorkshopRootPluginDir)</RWImGuiPluginDir>
    <RWImGuiPluginDir Condition="'$(RWImGuiPluginDir)' == '' and Exists('$(RWImGuiWorkshopPackagePluginDir)/rain-world-imgui-api.dll')">$(RWImGuiWorkshopPackagePluginDir)</RWImGuiPluginDir>
    <RWImGuiPluginDir Condition="'$(RWImGuiPluginDir)' == '' and Exists('$(RWImGuiLocalPluginDir)/rain-world-imgui-api.dll')">$(RWImGuiLocalPluginDir)</RWImGuiPluginDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Game/**/*.cs" />
    <!-- Retired hover-preview implementation: it must not ship hooks, probes or runtime work. -->
    <Compile Remove="Game/DevTool/Preview/EffectPreview*.cs" />
    <EmbeddedResource Include="Assets/Fonts/*.ttf" LogicalName="RainWright.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Fonts/LICENSE-*.txt" LogicalName="RainWright.Fonts.%(Filename)%(Extension)" />
    <Compile Include="../Shared/AuthoringSourcePaths.cs" Link="IO/AuthoringSourcePaths.cs" />
    <Reference Include="System.Drawing">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/System.Drawing.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="BepInEx">
      <HintPath>$(RainWorldDir)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(RainWorldDir)/BepInEx/core/MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(RainWorldDir)/BepInEx/core/MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(RainWorldDir)/BepInEx/core/Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PUBLIC-Assembly-CSharp">
      <HintPath>$(RainWorldDir)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HOOKS-Assembly-CSharp">
      <HintPath>$(RainWorldDir)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestWWWModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.UnityWebRequestWWWModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="rain-world-imgui-api">
      <HintPath>$(RWImGuiPluginDir)/rain-world-imgui-api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ImGui.NET">
      <HintPath>$(RWImGuiPluginDir)/ImGui.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Numerics" />
  </ItemGroup>
  <Target Name="ValidateRainWrightLocalOutput" BeforeTargets="PrepareForBuild" Condition="'$(DeployToGame)' == 'true'">
    <Error Condition="'$(RainWrightModOutputDir)' == '' or !Exists('$(RainWrightModRootDir)/modinfo.json')"
           Text="RainWright Mod was not found. Set RainWorldDir or RainWrightModRootDir to your installation, or use DeployToGame=false for an isolated build." />
  </Target>
  <Target Name="DeployRainWrightModMetadata" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <RainWrightModTranslation Include="$(MSBuildThisFileDirectory)../../mod/text/**/strings.txt" />
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../mod/modinfo.json"
          DestinationFiles="$(RainWrightModRootDir)/modinfo.json"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RainWrightModTranslation)"
          DestinationFiles="@(RainWrightModTranslation->'$(RainWrightModRootDir)/text/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
