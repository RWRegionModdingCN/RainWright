    <!-- The sprite sheets and their lookup contract belong to the publishable
         editor DLL, not the DryCycle gameplay assembly. -->
    <Compile Include="Backend/Cartography/CartographyResourceLocator.cs" />
    <EmbeddedResource Include="Backend/Cartography/Assets/*.png"
                      LogicalName="Rainwright.Cartography.%(Filename)%(Extension)" />
    <!-- Preserve existing namespace/member contracts during physical assembly
         extraction. Only the core Rainwright runtime and its consumers may
         access transitional internal types. -->
    <!-- View transforms use System.Numerics.Vector2 under Rain World's net48 runtime. -->
    <Reference Include="System.Numerics" Condition="'$(RainwrightStandaloneSmokeTest)' != 'true'" />
    <Reference Include="System.Xml.Linq" Condition="'$(RainwrightStandaloneSmokeTest)' != 'true'" />
    <Reference Include="System.Runtime.Serialization" Condition="'$(RainwrightStandaloneSmokeTest)' != 'true'" />
    <InternalsVisibleTo Include="DryCycle" />
