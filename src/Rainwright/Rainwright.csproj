<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Full RainWright Mod by default. CI can select the portable core,
         using separate output paths to protect the deployable game artifact. -->
    <TargetFramework Condition="'$(RainwrightStandaloneSmokeTest)' == 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RainwrightStandaloneSmokeTest)' != 'true'">net48</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>RainWright</AssemblyName>
    <RootNamespace>RainWright</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Separate the net10 test DLL from the actual net48 runtime artifact.
         A smoke/test build must not overwrite the game-deployable binary. -->
    <OutputPath Condition="'$(RainwrightStandaloneSmokeTest)' == 'true'">$(BaseOutputPath)$(Configuration)/net10-smoke/</OutputPath>
    <!-- Build locally by default. Installation is explicit through scripts/Install.ps1. -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <OutputPath Condition="'$(RainWrightPortableBuild)' == 'true'">$(BaseOutputPath)$(Configuration)/net48-core/</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Make the actual net48 DLL independently buildable on Windows and Linux
       agents. Reference assemblies are compile-time only; they are not packed
       into Rainwright.dll or copied beside the game. -->
  <ItemGroup Condition="'$(RainwrightStandaloneSmokeTest)' != 'true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
                      Version="1.0.3" PrivateAssets="all" />
    <!-- Sound group snapshots use init accessors under the net48 game target. -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Backend/Core/EditorBackupFiles.cs" />
    <Compile Include="Backend/Settings/RainWrightPersonalSettings.cs" />
    <Compile Include="Runtime/FrontendHookLedger.cs" />
    <Compile Include="Runtime/EditorBackendServiceLedger.cs" />
    <Compile Include="Runtime/PlayerMapServiceLifetimeLedger.cs" />
    <!-- Shared editor UI mode, global shortcut animation bus and diagnostic
         counters live in this DLL so multiple plugin frontends see one state. -->
    <Compile Include="Backend/Core/EditorUiModeState.cs" />
    <!-- Canonical editor identity and shortcut catalog used by all frontends. -->
    <Compile Include="Backend/Core/EditorDocumentIdentity.cs" />
